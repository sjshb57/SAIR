<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="8dp">

    <CheckBox
        android:id="@+id/cb_scheme_v1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/signing_schemes_v1"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_scheme_v1_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginBottom="12dp"
        android:text="@string/signing_schemes_v1_summary"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp" />

    <CheckBox
        android:id="@+id/cb_scheme_v2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/signing_schemes_v2"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_scheme_v2_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginBottom="12dp"
        android:text="@string/signing_schemes_v2_summary"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp" />

    <CheckBox
        android:id="@+id/cb_scheme_v3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/signing_schemes_v3"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_scheme_v3_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginBottom="16dp"
        android:text="@string/signing_schemes_v3_summary"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/signing_schemes_note"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp" />


</LinearLayout>
